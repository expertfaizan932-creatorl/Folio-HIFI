# ---------------------------------------------------------------------------
# WorkFolio deployment settings
# ---------------------------------------------------------------------------
#   cp .env.example .env
# then fill in every value marked REQUIRED and run:
#   docker compose up -d --build
#
# .env must never be committed. It holds the database and certificate-account
# credentials.
# ---------------------------------------------------------------------------

# REQUIRED. The public hostname the app is served on, e.g. workfolio.acme.com.
# Its A record must point at this server before the first `up`, otherwise
# Caddy cannot obtain a certificate.
DOMAIN=workfolio.example.com

# REQUIRED. Used by Let's Encrypt for expiry warnings. Use a real address you
# read - certificate problems are otherwise invisible until they expire.
ACME_EMAIL=admin@acme.com

# REQUIRED. Root password for the MySQL container.
MYSQL_ROOT_PASSWORD=change-me-root-password

# Database name and the unprivileged application user.
DB_NAME=workfolio
DB_USER=workfolio
# REQUIRED. Password for that application user.
DB_PASSWORD=change-me-app-password

# How many days of screenshots to keep before StorageMaintenance prunes them.
# Screenshots are the most sensitive records this system holds; keep it short.
WORKFOLIO_RETENTION_DAYS=14
